# Canonical .gitignore for my projects. Copy to a repo root as `.gitignore`.
# Covers the build artifacts and dependency dirs the build-artifact-guard hook
# blocks. Trim the sections a given repo does not use.

# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Node / JS / TS ---
node_modules/
dist/
build/
.next/
.astro/
*.tsbuildinfo
coverage/
.pnpm-store/

# --- .NET ---
bin/
obj/
*.user
*.dll
*.pdb
[Tt]est[Rr]esults/

# --- Python ---
__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/

# --- Editors / OS ---
.DS_Store
.idea/
.vs/
*.swp
